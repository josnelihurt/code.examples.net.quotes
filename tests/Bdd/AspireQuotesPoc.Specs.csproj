<Project Sdk="Microsoft.NET.Sdk">

  <!-- Named *.Specs.csproj on purpose: CI's and scripts/test.sh's `*.Tests.csproj` glob keeps
       this project out of the fast unit gate — it boots the real Aspire stack, needs a
       container runtime for the YARP gateway and takes minutes, not microseconds. Living
       under tests/ inherits tests/Directory.Build.props, which already provides what
       Reqnroll.xunit.v3 needs: xunit.v3, Microsoft.NET.Test.Sdk and OutputType=Exe. -->
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Reqnroll.Tools.MsBuild.Generation" />
    <PackageReference Include="Reqnroll.xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The AppHost is the system under test; its Aspire SDK generates the Projects.* metadata. -->
    <ProjectReference Include="..\..\src\AppHost\AspireQuotesPoc.AppHost.csproj" />
  </ItemGroup>

</Project>
