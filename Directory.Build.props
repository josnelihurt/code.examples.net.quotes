<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Roslyn only reports IDE0005 (unused usings) when the doc file is generated; CS1591 is the
         "missing XML comment" noise that comes with it and is not wanted here. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The Microsoft.AspNetCore.OpenApi XML-comment source generator rewrites AddOpenApi calls
         through interceptors in this namespace. The package setting does not flow transitively,
         so it is enabled once here; projects the generator does not run in are unaffected. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- MessagePack 2.5.302 (transitive via Aspire.Hosting.*) has a known medium-severity
       advisory with no patched release yet: GHSA-qhrr-8q5h-9q3h (nested arrays can blow
       past buffer length limits). NU1902-as-error fails the Release restore; suppress the
       advisory explicitly here and remove this once MessagePack ships the fix. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qhrr-8q5h-9q3h" />
  </ItemGroup>

</Project>
