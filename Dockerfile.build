# syntax=docker/dockerfile:1

# Hermetic OpenAPI freeze: build Auth/Quotes APIs, export each /openapi/{document}.json to YAML.
# Extract with: ./scripts/update-contracts.sh  (podman|docker build + cp from scratch stage)

# Digest-pinned so the "frozen" contract export cannot churn when the floating tag moves;
# bump deliberately via `podman pull mcr.microsoft.com/dotnet/sdk:10.0 && podman images --digests`.
FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:e1ffd2a92ae84c1291bc1b6887501f8af98e6331e7af6d4c8d37168c5e87a64c AS build
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props nuget.config ./
COPY src/ServiceDefaults ./src/ServiceDefaults
COPY src/Auth ./src/Auth
COPY src/Quotes ./src/Quotes

RUN dotnet restore src/Auth/Auth.Api/Auth.Api.csproj \
 && dotnet restore src/Quotes/Quotes.Api/Quotes.Api.csproj \
 && dotnet build src/Auth/Auth.Api/Auth.Api.csproj -c Release --no-restore \
 && dotnet build src/Quotes/Quotes.Api/Quotes.Api.csproj -c Release --no-restore

FROM build AS export
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl python3-yaml postgresql \
 && rm -rf /var/lib/apt/lists/*

RUN bash -euo pipefail <<'EOF'
mkdir -p /out /tmp/logs

# Throwaway key for the export only: both APIs must agree on it, and it must never
# match the committed development key (the Production guard would reject it, and
# this throwaway never leaves the build container). Generated randomly at build time,
# so no key literal lives in the repository.
export Jwt__SigningKey="openapi-export-$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"

# The Quotes API needs its catalog database even to serve the OpenAPI documents (it
# migrates at boot), so start the cluster Debian just installed and hand it a throwaway
# catalog. No docker-in-docker: this stays a hermetic single-image build.
PG_VERSION="$(ls /etc/postgresql | head -n1)"
pg_ctlcluster "${PG_VERSION}" main start
su postgres -c "psql -c \"ALTER USER postgres PASSWORD 'postgres';\"" >/dev/null
su postgres -c "createdb quotesdb"
for i in $(seq 1 60); do
  if pg_isready -U postgres -d quotesdb >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
export ConnectionStrings__quotesdb="Host=127.0.0.1;Port=5432;Username=postgres;Password=postgres;Database=quotesdb"

ASPNETCORE_ENVIRONMENT=Development \
ASPNETCORE_URLS=http://127.0.0.1:18081 \
  dotnet run --project src/Auth/Auth.Api/Auth.Api.csproj -c Release --no-build --no-launch-profile \
  >/tmp/logs/auth.log 2>&1 &
AUTH_PID=$!

ASPNETCORE_ENVIRONMENT=Development \
ASPNETCORE_URLS=http://127.0.0.1:18082 \
  dotnet run --project src/Quotes/Quotes.Api/Quotes.Api.csproj -c Release --no-build --no-launch-profile \
  >/tmp/logs/quotes.log 2>&1 &
QUOTES_PID=$!

wait_for() {
  local url="$1"
  local i
  for i in $(seq 1 60); do
    if curl -fsS "$url" -o /dev/null; then
      return 0
    fi
    sleep 0.5
  done
  echo "Timed out waiting for ${url}" >&2
  cat /tmp/logs/auth.log /tmp/logs/quotes.log >&2 || true
  return 1
}

# Auth serves one document; Quotes serves one per API version (v0 controllers, v1 minimal APIs).
wait_for http://127.0.0.1:18081/openapi/v1.json
wait_for http://127.0.0.1:18082/openapi/v1.json

curl -fsS http://127.0.0.1:18081/openapi/v1.json -o /tmp/auth.json
curl -fsS http://127.0.0.1:18082/openapi/v0.json -o /tmp/quotes-v0.json
curl -fsS http://127.0.0.1:18082/openapi/v1.json -o /tmp/quotes-v1.json

python3 <<'PY'
import json
from pathlib import Path

import yaml

for name in ("auth", "quotes-v0", "quotes-v1"):
    doc = json.loads(Path(f"/tmp/{name}.json").read_text())
    doc["servers"] = [{"url": "/"}]
    Path(f"/out/{name}.openapi.yaml").write_text(
        yaml.safe_dump(doc, sort_keys=False, allow_unicode=True)
    )
PY

kill "${AUTH_PID}" "${QUOTES_PID}" 2>/dev/null || true
wait "${AUTH_PID}" "${QUOTES_PID}" 2>/dev/null || true
EOF

FROM scratch AS contracts
COPY --from=export /out/auth.openapi.yaml /auth.openapi.yaml
COPY --from=export /out/quotes-v0.openapi.yaml /quotes-v0.openapi.yaml
COPY --from=export /out/quotes-v1.openapi.yaml /quotes-v1.openapi.yaml
