# Container image references shared by every boot path (test fixtures, e2e scripts, CI).
# These mirror the tags the pinned Aspire.Hosting.* packages actually run — the source
# of truth is the package, this file is the repo's one copy. scripts/check-image-tags.sh
# fails CI when the two diverge; the bump procedure lives in docs/dependency-refresh.md.
POSTGRES_IMAGE=docker.io/library/postgres:18.3
PGWEB_IMAGE=docker.io/sosedoff/pgweb:0.17.0
YARP_IMAGE=mcr.microsoft.com/dotnet/nightly/yarp:2.3-preview
